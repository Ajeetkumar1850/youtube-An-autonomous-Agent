# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/youtube_agent

# Redis
REDIS_URL=redis://localhost:6379/0

# API
API_HOST=0.0.0.0
API_PORT=8000

# LLM
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Image Generation
IMAGE_API_URL=https://image.pollinations.ai/prompt
IMAGE_API_TIMEOUT=90

# Voice
VOICE_MODEL=hi-IN-SwaraNeural
VOICE_RATE=+10%

# Video
VIDEO_FPS=24
VIDEO_BITRATE=2500k
VIDEO_PRESET=ultrafast

# YouTube
YOUTUBE_CLIENT_SECRET_PATH=client_secret.json
YOUTUBE_CATEGORY_ID=22

# Logging
LOG_LEVEL=INFO
